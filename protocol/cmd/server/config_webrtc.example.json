{
    "bind_address": ":443",
    "sni": "rtc.example.com",
    "transport": "webrtc",
    "tls": {
        "cert_file": "/etc/ssl/fullchain.pem",
        "key_file": "/etc/ssl/privkey.pem"
    },
    "webrtc": {
        "enabled": true,
        "path": "/rtc/o",
        "stun_servers": [
            "stun:stun.l.google.com:19302"
        ]
    },
    "users": [
        {
            "id": "user1",
            "psk": "CHANGE-ME-RANDOM-STRING-HERE",
            "max_bandwidth": 104857600,
            "allowed_ports": [
                {
                    "from": 1,
                    "to": 65535
                }
            ],
            "expires_at": "2027-12-31T23:59:59Z"
        }
    ],
    "firewall": {
        "blocked_ports": [
            25,
            465,
            587,
            137,
            138,
            139,
            445
        ],
        "max_connections_per_user": 2000,
        "max_bandwidth_default": 0,
        "allow_private_ranges": false
    },
    "padding": {
        "enabled": true,
        "min_padding_bytes": 16,
        "max_padding_bytes": 256,
        "normalize_size": true
    },
    "stealth": {
        "enabled": true,
        "decoy_streams": true,
        "protocol_polymorphism": true,
        "adaptive_throttling": true
    }
}
