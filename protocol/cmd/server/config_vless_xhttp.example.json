{
    "bind_address": ":443",
    "sni": "cdn.example.com",
    "transport": "vless-xhttp",
    "tls": {
        "cert_file": "/etc/ssl/fullchain.pem",
        "key_file": "/etc/ssl/privkey.pem"
    },
    "vless": {
        "clients": [
            {
                "id": "b831381d-6324-4d53-ad4f-8cda48b30811",
                "email": "user1@example.com"
            }
        ]
    },
    "xhttp": {
        "path": "/xhttp",
        "host": "cdn.example.com",
        "mode": "packet-up",
        "extra": {
            "xPaddingBytes": "100-1000",
            "scMaxEachPostBytes": "1000000-1000000",
            "scMaxConcurrentPosts": "100-200",
            "scMinPostsIntervalMs": "30-30",
            "scMaxBufferedPosts": 30,
            "noSSEHeader": false
        }
    },
    "firewall": {
        "blocked_ports": [
            25,
            465,
            587,
            137,
            138,
            139,
            445
        ],
        "max_connections_per_user": 2000,
        "max_bandwidth_default": 0,
        "allow_private_ranges": false
    }
}
